+/** @file tee_color_frame.h
+ * Color frame that carries both the decoded image and the device's own
+ * compressed JPEG bytes ("the tee"). Frames come from a fixed pool owned
+ * by the tee processor; deleting the frame returns its buffers to the
+ * pool. See the Kinect Creative Studio fork notes for rationale.
+ */
+
+#ifndef TEE_COLOR_FRAME_H_
+#define TEE_COLOR_FRAME_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <libfreenect2/config.h>
+#include <libfreenect2/frame_listener.hpp>
+
+namespace libfreenect2
+{
+
+class TeeFramePool;
+
+/** Counters published by the tee processor. All failure modes are counted,
+ * never silent: a frame is either delivered with both products or dropped
+ * with the reason recorded here. */
+struct LIBFREENECT2_API TeeStats
+{
+  uint64_t delivered;              ///< frames delivered with decoded image + JPEG bytes
+  uint64_t dropped_pool_exhausted; ///< consumer held all pool slots; frame dropped
+  uint64_t dropped_jpeg_too_large; ///< device JPEG exceeded the slot capacity; frame dropped
+  uint64_t decode_errors;          ///< TurboJPEG decode failed; frame dropped
+};
+
+/** A decoded color frame that also owns a copy of the device JPEG bytes.
+ *
+ * Lifetime: produced only by the tee processor's fixed pool. The listener
+ * takes ownership per the usual libfreenect2 contract; `delete` returns the
+ * slot to the pool (the pool itself is kept alive by shared ownership, so
+ * frames may safely outlive the processor).
+ */
+class LIBFREENECT2_API TeeColorFrame : public Frame
+{
+public:
+  virtual ~TeeColorFrame();
+
+  /** Device JPEG bytes exactly as received from the sensor. */
+  const unsigned char *jpegData() const { return jpeg_data_; }
+  size_t jpegLength() const { return jpeg_length_; }
+
+private:
+  friend class TeeFramePool;
+  TeeColorFrame(size_t width, size_t height, size_t bytes_per_pixel,
+                unsigned char *pixels);
+
+  unsigned char *jpeg_data_;
+  size_t jpeg_length_;
+  TeeFramePool *pool_; ///< owning pool; refcounted via pool-internal count
+  size_t slot_;
+};
+
+} /* namespace libfreenect2 */
+#endif /* TEE_COLOR_FRAME_H_ */
