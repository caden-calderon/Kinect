new file mode 100644
index 0000000..0c2bd81
--- /dev/null
+++ b/src/tee_jpeg_rgb_packet_processor.cpp
@@ -0,0 +1,266 @@
+/*
+ * This file is part of the Kinect Creative Studio fork of libfreenect2.
+ *
+ * Copyright (c) 2014 individual OpenKinect contributors. See the CONTRIB file
+ * for details.
+ *
+ * This code is licensed to you under the terms of the Apache License, version
+ * 2.0, or, at your option, the terms of the GNU General Public License,
+ * version 2.0. See the APACHE20 and GPL2 files for the text of the licenses,
+ * or the following URLs:
+ * http://www.apache.org/licenses/LICENSE-2.0
+ * http://www.gnu.org/licenses/gpl-2.0.txt
+ */
+
+/** @file tee_jpeg_rgb_packet_processor.cpp
+ * The color tee: per packet, retain the device JPEG bytes AND decode them
+ * with TurboJPEG, publishing both through one pooled TeeColorFrame.
+ *
+ * Discipline (per the studio architecture): fixed pool, no steady-state
+ * allocation, pool exhaustion drops the frame with a counted event and
+ * never blocks the packet thread.
+ */
+
+#include <libfreenect2/rgb_packet_processor.h>
+#include <libfreenect2/tee_color_frame.h>
+#include <libfreenect2/logging.h>
+#include <libfreenect2/threading.h>
+
+#include <turbojpeg.h>
+
+#include <atomic>
+#include <cstring>
+#include <vector>
+
+namespace libfreenect2
+{
+
+/** Fixed pool of frame slots, shared between the processor and the frames
+ * it has published. Refcounted so frames may outlive the processor. */
+class TeeFramePool
+{
+public:
+  static const size_t kColorWidth = 1920;
+  static const size_t kColorHeight = 1080;
+  static const size_t kBytesPerPixel = 4; // BGRX
+  static const size_t kJpegCapacity = 2 * 1024 * 1024;
+
+  explicit TeeFramePool(size_t slot_count) :
+    refcount_(1),
+    slots_(slot_count)
+  {
+    for (size_t i = 0; i < slots_.size(); ++i)
+    {
+      slots_[i].pixels = new unsigned char[kColorWidth * kColorHeight * kBytesPerPixel];
+      slots_[i].jpeg = new unsigned char[kJpegCapacity];
+      slots_[i].in_use = false;
+    }
+  }
+
+  void addRef()
+  {
+    refcount_.fetch_add(1, std::memory_order_relaxed);
+  }
+
+  void release()
+  {
+    if (refcount_.fetch_sub(1, std::memory_order_acq_rel) == 1)
+      delete this;
+  }
+
+  /** Acquire a free slot, or SIZE_MAX if the pool is exhausted. Never blocks
+   * beyond the freelist mutex (held only for the flag flip). */
+  size_t acquire()
+  {
+    libfreenect2::lock_guard guard(mutex_);
+    for (size_t i = 0; i < slots_.size(); ++i)
+    {
+      if (!slots_[i].in_use)
+      {
+        slots_[i].in_use = true;
+        return i;
+      }
+    }
+    return SIZE_MAX;
+  }
+
+  void releaseSlot(size_t index)
+  {
+    libfreenect2::lock_guard guard(mutex_);
+    slots_[index].in_use = false;
+  }
+
+  unsigned char *pixels(size_t index) { return slots_[index].pixels; }
+  unsigned char *jpeg(size_t index) { return slots_[index].jpeg; }
+
+  /** Construct a frame on an acquired slot; the frame carries one pool ref. */
+  TeeColorFrame *makeFrame(size_t index, size_t jpeg_length)
+  {
+    TeeColorFrame *frame =
+        new TeeColorFrame(kColorWidth, kColorHeight, kBytesPerPixel, slots_[index].pixels);
+    frame->jpeg_data_ = slots_[index].jpeg;
+    frame->jpeg_length_ = jpeg_length;
+    frame->pool_ = this;
+    frame->slot_ = index;
+    addRef();
+    return frame;
+  }
+
+private:
+  ~TeeFramePool()
+  {
+    for (size_t i = 0; i < slots_.size(); ++i)
+    {
+      delete[] slots_[i].pixels;
+      delete[] slots_[i].jpeg;
+    }
+  }
+
+  struct Slot
+  {
+    unsigned char *pixels;
+    unsigned char *jpeg;
+    bool in_use;
+  };
+
+  std::atomic<uint64_t> refcount_;
+  std::vector<Slot> slots_;
+  libfreenect2::mutex mutex_;
+};
+
+TeeColorFrame::TeeColorFrame(size_t width, size_t height, size_t bytes_per_pixel,
+                             unsigned char *pixels) :
+  Frame(width, height, bytes_per_pixel, pixels),
+  jpeg_data_(NULL),
+  jpeg_length_(0),
+  pool_(NULL),
+  slot_(0)
+{
+}
+
+TeeColorFrame::~TeeColorFrame()
+{
+  if (pool_ != NULL)
+  {
+    pool_->releaseSlot(slot_);
+    pool_->release();
+  }
+}
+
+class TeeJpegRgbPacketProcessorImpl : public WithPerfLogging
+{
+public:
+  tjhandle decompressor;
+  TeeFramePool *pool;
+
+  std::atomic<uint64_t> delivered;
+  std::atomic<uint64_t> dropped_pool_exhausted;
+  std::atomic<uint64_t> dropped_jpeg_too_large;
+  std::atomic<uint64_t> decode_errors;
+
+  explicit TeeJpegRgbPacketProcessorImpl(size_t pool_size) :
+    delivered(0),
+    dropped_pool_exhausted(0),
+    dropped_jpeg_too_large(0),
+    decode_errors(0)
+  {
+    decompressor = tjInitDecompress();
+    if (decompressor == 0)
+    {
+      LOG_ERROR << "Failed to initialize TurboJPEG decompressor! TurboJPEG error: '"
+                << tjGetErrorStr() << "'";
+    }
+    pool = new TeeFramePool(pool_size);
+  }
+
+  ~TeeJpegRgbPacketProcessorImpl()
+  {
+    pool->release();
+    if (decompressor != 0)
+    {
+      if (tjDestroy(decompressor) == -1)
+      {
+        LOG_ERROR << "Failed to destroy TurboJPEG decompressor! TurboJPEG error: '"
+                  << tjGetErrorStr() << "'";
+      }
+    }
+  }
+};
+
+TeeJpegRgbPacketProcessor::TeeJpegRgbPacketProcessor(size_t pool_size) :
+  impl_(new TeeJpegRgbPacketProcessorImpl(pool_size))
+{
+}
+
+TeeJpegRgbPacketProcessor::~TeeJpegRgbPacketProcessor()
+{
+  delete impl_;
+}
+
+TeeStats TeeJpegRgbPacketProcessor::teeStats() const
+{
+  TeeStats stats;
+  stats.delivered = impl_->delivered.load(std::memory_order_relaxed);
+  stats.dropped_pool_exhausted = impl_->dropped_pool_exhausted.load(std::memory_order_relaxed);
+  stats.dropped_jpeg_too_large = impl_->dropped_jpeg_too_large.load(std::memory_order_relaxed);
+  stats.decode_errors = impl_->decode_errors.load(std::memory_order_relaxed);
+  return stats;
+}
+
+void TeeJpegRgbPacketProcessor::process(const RgbPacket &packet)
+{
+  if (impl_->decompressor == 0 || listener_ == 0)
+    return;
+
+  if (packet.jpeg_buffer_length > TeeFramePool::kJpegCapacity)
+  {
+    impl_->dropped_jpeg_too_large.fetch_add(1, std::memory_order_relaxed);
+    LOG_WARNING << "device JPEG (" << packet.jpeg_buffer_length
+                << " bytes) exceeds tee slot capacity; frame dropped";
+    return;
+  }
+
+  size_t slot = impl_->pool->acquire();
+  if (slot == SIZE_MAX)
+  {
+    impl_->dropped_pool_exhausted.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+
+  impl_->startTiming();
+
+  std::memcpy(impl_->pool->jpeg(slot), packet.jpeg_buffer, packet.jpeg_buffer_length);
+
+  int r = tjDecompress2(impl_->decompressor, packet.jpeg_buffer, packet.jpeg_buffer_length,
+                        impl_->pool->pixels(slot), TeeFramePool::kColorWidth,
+                        TeeFramePool::kColorWidth * TeeFramePool::kBytesPerPixel,
+                        TeeFramePool::kColorHeight, TJPF_BGRX, 0);
+
+  impl_->stopTiming(LOG_INFO);
+
+  if (r != 0)
+  {
+    impl_->decode_errors.fetch_add(1, std::memory_order_relaxed);
+    impl_->pool->releaseSlot(slot);
+    LOG_ERROR << "Failed to decompress rgb image! TurboJPEG error: '" << tjGetErrorStr() << "'";
+    return;
+  }
+
+  TeeColorFrame *frame = impl_->pool->makeFrame(slot, packet.jpeg_buffer_length);
+  frame->timestamp = packet.timestamp;
+  frame->sequence = packet.sequence;
+  frame->exposure = packet.exposure;
+  frame->gain = packet.gain;
+  frame->gamma = packet.gamma;
+  frame->format = Frame::BGRX;
+
+  impl_->delivered.fetch_add(1, std::memory_order_relaxed);
+
+  if (!listener_->onNewFrame(Frame::Color, frame))
+  {
+    // Listener declined ownership; recycle immediately.
+    delete frame;
+  }
+}
+
+} /* namespace libfreenect2 */
