index ad74ed1..8280286 100644
--- a/include/internal/libfreenect2/depth_packet_processor.h
+++ b/include/internal/libfreenect2/depth_packet_processor.h
@@ -47,6 +47,7 @@ struct DepthPacket
   uint32_t timestamp;
   unsigned char *buffer; ///< Depth data.
   size_t buffer_length;  ///< Size of depth data.
+  uint64_t host_receive_ns; ///< CLOCK_MONOTONIC at packet completion (fork)
 
