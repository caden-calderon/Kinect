@@ -28,6 +28,7 @@
 
 #include <libfreenect2/depth_packet_stream_parser.h>
 #include <libfreenect2/logging.h>
+#include <ctime>
 #include <memory.h>
 
 namespace libfreenect2
@@ -116,6 +117,11 @@ void DepthPacketStreamParser::onDataReceived(unsigned char* buffer, size_t in_le
               packet.timestamp = footer->timestamp;
               packet.buffer = packet_.memory->data;
               packet.buffer_length = packet_.memory->capacity;
+              {
+                struct timespec ts;
+                clock_gettime(CLOCK_MONOTONIC, &ts);
+                packet.host_receive_ns = (uint64_t)ts.tv_sec * 1000000000ull + ts.tv_nsec;
+              }
 
               processor_->process(packet);
               processor_->allocateBuffer(packet_, buffer_size_);
